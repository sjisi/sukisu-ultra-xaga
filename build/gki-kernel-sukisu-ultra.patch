--- /dev/null
+++ b/drivers/kernelsu/runtime/ksud_integration.c
@@ -0,0 +1,659 @@
+#include "feature/selinux_hide.h"
+#include <linux/rcupdate.h>
+#include <linux/slab.h>
+#include <linux/mm.h>
+#include <asm/current.h>
