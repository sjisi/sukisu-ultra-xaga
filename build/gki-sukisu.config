# SukiSU Ultra options overlay for GKI 5.10 (HyperOS path)
CONFIG_KSU=y
CONFIG_KPM=y
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Debug info makes the vmlinux link exceed GitHub runner memory; not needed
# for a flashable kernel.
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
